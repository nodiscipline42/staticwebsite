---
import Layout from '../layouts/Layout.astro'

import { profile } from '@/settings'
import { publications } from '@/data/cv'
import ProfilePictures from '@/assets/victoria2025.jpg'
import Hero from '@/components/ui/Hero.astro'
import Grid from '@/components/ui/Grid.astro'
import ArticleList from '@/components/ui/ArticleList.astro'
import PresentationWindow from '@/components/ui/PresentationWindow.astro'

const { fullName, title, institute, research_areas } = profile

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<!-- Hero Section -->
	<section class='flex items-center gap-12 border-b pb-12'>
		<Hero
			fullName={fullName}
			title={title}
			institute={institute}
			profilePicture={ProfilePictures}
		/>
	</section>

	<!-- Field Notes -->
	<section class='py-12 border-b'>
		<div class='rounded-2xl border border-base-300 bg-base-200/50 p-6 sm:p-8'>
			<p class='mb-3 text-sm uppercase tracking-[0.2em] text-primary/80'>field notes</p>
			<h2 class='text-2xl font-bold'>What I’m tracing lately</h2>
			<p class='mt-3 max-w-2xl text-base-content/70'>I’m interested in the ways games stage environments: oceans as thresholds, ruins as memory, and systems that quietly shape who belongs in a scene.</p>
			<div class='mt-6 grid gap-4 md:grid-cols-3'>
				<div class='rounded-xl border border-base-300 bg-base-100 p-4'>
					<p class='font-semibold'>Blue worlds</p>
					<p class='mt-2 text-sm text-base-content/70'>How oceans and submerged spaces are imagined in popular games.</p>
				</div>
				<div class='rounded-xl border border-base-300 bg-base-100 p-4'>
					<p class='font-semibold'>Game systems</p>
					<p class='mt-2 text-sm text-base-content/70'>The hidden rules that make some worlds feel inhabited and others disposable.</p>
				</div>
				<div class='rounded-xl border border-base-300 bg-base-100 p-4'>
					<p class='font-semibold'>Environmental thought</p>
					<p class='mt-2 text-sm text-base-content/70'>A long-term interest in atmosphere, ecology, and what media makes visible.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Research Areas -->
	<section class='py-12 border-b'>
		<Grid gridTitle='Research Areas' gridItems={research_areas} />
	</section>

	<!-- Latest Presentation -->
	<section class='py-12 border-b'>
		<div class='mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between'>
			<div>
				<h2 class='text-2xl font-bold'>A recent slide talk</h2>
				<p class='mt-1 text-sm text-base-content/70'>More informal than a paper, but still a way of thinking through an idea.</p>
			</div>
			<a
				href='/old-enough-to-be-scared-full.html'
				target='_blank'
				rel='noopener noreferrer'
				class='inline-flex items-center justify-center rounded-full border border-primary/30 bg-primary/10 px-4 py-2 text-sm font-medium text-primary transition hover:bg-primary/20'
			>
				Open the full talk
			</a>
		</div>
		<div class='overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm'>
			<div class='border-b border-base-300 bg-base-200/70 px-4 py-3'>
				<p class='text-sm text-base-content/70'>Old Enough to Be Scared</p>
			</div>
			<div class='p-2 sm:p-3'>
				<iframe
					src='/old-enough-to-be-scared-full.html'
					title='Old Enough to Be Scared'
					class='h-[80vh] min-h-[700px] w-full rounded-xl border-0'
					loading='lazy'
				></iframe>
			</div>
		</div>
	</section>

	<!-- Recent Publications -->
	<section class='py-12 border-t'>
		<ArticleList listTitle='Recent Publications' listItems={publications} />
	</section>
</Layout>
