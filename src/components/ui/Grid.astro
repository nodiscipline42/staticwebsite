---
interface Props {
  gridTitle: string;
  gridItems: {
    title: string;
    description: string;
  }[];
}

const {gridTitle, gridItems} = Astro.props;
---
<h2 class="text-3xl font-bold mb-8">{gridTitle}</h2>
<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
  {gridItems.map((item) => (
    <div class="rounded-[1.25rem] border border-base-300/70 bg-base-200/60 p-6 text-base-content shadow-[0_8px_24px_rgba(15,35,55,0.04)]">
      <h3 class="mb-3 text-xl font-semibold">{item.title}</h3>
      <p class="text-base-content/80">{item.description}</p>
    </div>
  ))}
</div>
