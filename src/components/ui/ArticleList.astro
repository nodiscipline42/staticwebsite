---
interface Props {
  listTitle: string;
  listItems: {
    title: string;
    journal: string;
    time: string;
  }[];
}
const {listTitle, listItems} = Astro.props
---

<h2 class='mb-8 text-3xl font-bold'>{listTitle}</h2>
		<div class='space-y-4'>
			{
				listItems.map(item => (
					<div class='rounded-[1.25rem] border border-base-300/70 bg-base-200/60 p-6 text-base-content shadow-[0_8px_24px_rgba(15,35,55,0.04)]'>
						<h3 class='mb-2 text-xl font-semibold'>{item.title}</h3>
						<p class='text-base-content/80'>
							{item.journal} • {item.time}
						</p>
					</div>
				))
			}
		</div>
