---
const { title, description, src, linkText = 'Open full screen' } = Astro.props
---

<div class='overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm'>
  <div class='flex flex-wrap items-center justify-between gap-3 border-b border-base-300 bg-base-200/70 px-4 py-3'>
    <div>
      <h3 class='text-lg font-semibold'>{title}</h3>
      <p class='text-sm text-base-content/70'>{description}</p>
    </div>
    <a
      href={src}
      target='_blank'
      rel='noopener noreferrer'
      class='btn btn-sm btn-outline'
    >
      {linkText}
    </a>
  </div>
  <div class='p-3'>
    <div class='overflow-hidden rounded-xl border border-base-300 bg-base-200'>
      <iframe
        src={src}
        title={title}
        class='aspect-[16/10] w-full border-0'
        loading='lazy'
      ></iframe>
    </div>
  </div>
</div>
