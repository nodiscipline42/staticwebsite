---
import { Image } from 'astro:assets'

import SocialIcons from './SocialIcons.astro'


const {fullName, title, institute, profilePicture} = Astro.props
---
<div class='flex-1 rounded-[1.75rem] border border-base-300/70 bg-base-200/50 p-7 shadow-[0_12px_35px_rgba(15,35,55,0.05)] sm:p-8'>
  <p class='mb-4 text-[0.7rem] uppercase tracking-[0.35em] text-base-content/50'>About</p>
  <h1 class='mb-4 text-4xl font-semibold leading-tight'>
    Welcome. I’m <span class='text-primary'>{fullName}</span>
  </h1>
  <p class='mb-5 text-sm uppercase tracking-[0.3em] text-base-content/60'>{title}{institute ? ` at ${institute}` : ''}</p>
  <p class='mb-6 text-lg leading-relaxed text-base-content/80'>
    I’m drawn to stories that move across media and to environments that feel more than just background. My work often begins with games, tracing patterns across large samples and datasets, but it also reaches into film, photography, and environmental thought – especially around water, submerged worlds, visual atmosphere, and the blue in everything.
  </p>
  <div class='flex gap-4'>
    <SocialIcons />
  </div>
</div>
<div class='hidden size-72 lg:block'>
  <div class='overflow-hidden rounded-[1.75rem] border border-base-300/70 bg-base-200/60 p-2 shadow-[0_16px_40px_rgba(15,35,55,0.08)]'>
    <Image
      src={profilePicture}
      alt={fullName}
      class='h-full w-full rounded-[1.25rem] object-cover'
    />
  </div>
</div>
