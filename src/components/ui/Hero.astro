---
import { Image } from 'astro:assets'

import SocialIcons from './SocialIcons.astro'


const {fullName, title, institute, profilePicture} = Astro.props
---
<div class='flex-1'>
  <h1 class='mb-4 text-4xl font-bold'>
    Welcome! I'm <span class='text-secondary'>{fullName}</span>
  </h1>
  <p class='mb-4 text-xl text-base-content/70'>{title}{institute ? ` at ${institute}` : ''}</p>
  <p class='mb-6 text-lg leading-8 text-base-content/70'>
    I'm drawn to stories that move across media and to environments that feel more than just background. My research often begins with games, tracing patterns across large samples and datasets, but it also reaches into film, photography, and environmental thought — especially around water, submerged worlds, visual atmosphere, and the blue in everything.
  </p>
  <div class='flex gap-4'>
    <SocialIcons />
  </div>
</div>
<div class='hidden size-72 lg:block'>
  <Image
    src={profilePicture}
    alt={fullName}
    class='h-full w-full rounded-full border border-base-300 object-cover shadow-sm'
  />
</div>
