---
import { Image } from 'astro:assets'

import SocialIcons from './SocialIcons.astro'


const {fullName, title, institute, profilePicture} = Astro.props
---
<div class='flex-1'>
  <h1 class='mb-4 text-4xl font-bold'>
    Welcome! I'm <span class='text-secondary'>{fullName}</span>
  </h1>
  <p class='mb-4 text-xl text-base-content/70'>{title}{institute ? ` at ${institute}` : ''}</p>
  <p class='mb-6 text-lg leading-8 text-base-content/70'>
    I’m interested in how stories move across media and how games make environments—especially oceans,—felt rather than simply seen.
  </p>
  <div class='flex gap-4'>
    <SocialIcons />
  </div>
</div>
<div class='hidden size-72 lg:block'>
  <Image
    src={profilePicture}
    alt={fullName}
    class='h-full w-full rounded-full border border-base-300 object-cover shadow-sm'
  />
</div>
