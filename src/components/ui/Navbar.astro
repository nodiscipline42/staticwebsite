---
import { Image } from 'astro:assets'
import {profile} from '../../settings'
import SocialIcons from './SocialIcons.astro'
import ProfilePictures from '@/assets/victoria2025.jpg'
import { getCollection } from 'astro:content'
import { template } from '@/settings'

const isBlogPopulated = await getCollection('blog').then(collection => collection.length > 0)

const {fullName, title} = profile
---
<aside
	class='h-screen w-[19.5rem] border-r border-primary/10 bg-gradient-to-b from-base-100 via-base-100 to-primary/10 px-4 pt-4 text-base-content'
>
	<div class='my-6 flex h-full flex-col justify-between'>
		<div>
			<div class='flex flex-col items-center justify-center'>
				<Image
					class='mask mask-circle size-36 border border-primary/15'
					src={ProfilePictures}
					alt={`Profile picture of ${fullName}`}
				/>
				<h1 class="mt-6 text-lg font-semibold tracking-tight"> {fullName}
				</h1>
				<p class='mt-1 text-center text-sm text-base-content/70'>{title}</p>
			</div>
			<div class='mx-3 mt-10'>
				<ul class='menu menu-md grow shrink space-y-2 overflow-y-auto rounded-2xl border border-primary/10 bg-base-100/80 p-3 shadow-sm'>
					<li>
	                        <a href={`${template.base}/`} class='text-base font-medium'>Home</a>
					</li>
					<li>
	                        <a href={`${template.base}/research`} class='text-base font-medium'>Projects</a>
					</li>
					<li>
	                        <a href={`${template.base}/papers`} class='text-base font-medium'>Papers</a>
					</li>
					<li>
						<a href={`${template.base}/talks`} class='text-base font-medium'>Talks</a>
					</li>
					<li>
						<a href={`${template.base}/courses`} class='text-base font-medium'>Courses</a>
					</li>
					<li>
	                        <a href={`${template.base}/cv`} class='text-base font-medium'>CV</a>
                    </li>
                    {isBlogPopulated &&
					<li>
	<a href="https://nodiscipline.hypotheses.org/" target="_blank" class='text-base font-medium'>
		Blog
	</a>
</li>
                    }
				</ul>
			</div>
		</div>
		<div class='mx-4 pb-3'>
			<SocialIcons/>
		</div>
	</div>
</aside>
